# --- PayPal (sandbox) — developer.paypal.com > Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# same value as PAYPAL_CLIENT_ID (exposed to the browser for PayPal Buttons)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# set after creating the webhook (Day 4)
PAYPAL_WEBHOOK_ID=

# --- AI provider: vertex | goedel | google
# vertex = Gemini on Google Cloud Vertex AI (Application Default Credentials; no key)
AI_PROVIDER=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3-flash-previewgoedel
GOEDEL_API_KEY=
GOEDEL_BASE_URL=https://api.goedelmachines.com/v1
GOEDEL_MODEL=deepseek/deepseek-v4.1-flash
# optional fallback
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# --- Product search — trychannel3.com
CHANNEL3_API_KEY=

# --- Database (defaults to the local docker Postgres if unset)
DATABASE_URL=postgres://mandate:mandate@localhost:5433/mandate
